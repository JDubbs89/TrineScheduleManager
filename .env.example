# Transcript import uses a signed-in cookie export; public catalog search needs no cookie.
MYPORTAL_COOKIES_JSON_FILE=./myportal-cookies.json
# Only this Schedule Manager account can import from the server's cookie store.
MYPORTAL_OWNER_USERNAME=jonathan
# Optional generated personal seed outside this repository, e.g. ../private/data.js
SCHEDULE_DATA_FILE=
# Optional local SQLite index for MyPortal course results.
SCHEDULE_CACHE_DB=./schedule-cache.sqlite3
# SQLite accounts and synchronized user schedules. Keep this file private and backed up.
SCHEDULE_USER_DB=./schedule-users.sqlite3
# Minimum pause between MyPortal requests during a catalog refresh.
MYPORTAL_REQUEST_INTERVAL_SECONDS=1.0
